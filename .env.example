# Frontend env. Copy this file to `.env` and restart `npm run dev`.

# Enable live API mode (optional). Leave unset to use bundled demo data.
VITE_API_URL=http://localhost:8000

# CARTO basemap API key (optional). Used for the "Light" basemap tiles.
# Get it from carto.com. Leave blank to use the free public CARTO tiles.
VITE_CARTO_API_KEY=
