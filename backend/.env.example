# Copy to .env and adjust. Never commit real secrets.
ENVIRONMENT=development
DEBUG=true

# PostGIS
POSTGRES_USER=jaldrishti
POSTGRES_PASSWORD=jaldrishti
POSTGRES_DB=jaldrishti
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_DIR=/data/storage

# CORS (frontend origins)
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Geospatial defaults
METRIC_CRS=EPSG:32643
DEFAULT_BUFFER_M=150
DEFAULT_TIME_WINDOW_DAYS=120
CLOUD_THRESHOLD_PCT=10
